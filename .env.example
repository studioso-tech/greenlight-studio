GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_REASONING_MODEL=gemini-2.5-flash
GEMINI_WRITER_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

CLICKHOUSE_HOST=xxxxxxxx.us-central1.gcp.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=greenlight
CLICKHOUSE_SECURE=1

TMDB_API_KEY=

MAX_COST_USD_PER_REQUEST=0.25
MAX_OUTPUT_TOKENS=2048
MAX_SQL_ROWS=200
AGENT_TIMEOUT_SEC=90
ALLOW_LOCAL_FALLBACK=0
DEFAULT_LOCALE=en
